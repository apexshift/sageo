# SageO connector credentials (placeholders only — never commit real secrets).
# Copy this file to `.env` locally (`.env` is gitignored).
# Connectors are shipped under connectors/ (gsc, ga4, crawl-serp).
# All connector access stays read-only through P5. Default make ci needs no secrets.

# Google Search Console (read-only)
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_PROPERTY_URL=

# Google Analytics 4 (read-only)
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=

# Crawl / SERP insights (DataForSEO; connectors/crawl-serp)
# CRAWL_SERP_API_KEY = dashboard API login + password as "login:password" (Basic auth)
# CRAWL_SERP_BASE_URL = https://api.dataforseo.com
CRAWL_SERP_API_KEY=
CRAWL_SERP_BASE_URL=
