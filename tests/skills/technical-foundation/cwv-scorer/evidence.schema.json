{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sageo://skills/technical-foundation/cwv-scorer/evidence.schema.json",
  "title": "cwv-scorer Evidence",
  "description": "Evidence array for evidence_requirement: full (lab-metrics CWV thresholds).",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["claim", "source", "observed_at", "confidence"],
    "properties": {
      "claim": { "type": "string", "minLength": 1 },
      "source": { "type": "string", "minLength": 1 },
      "observed_at": { "type": "string", "minLength": 1 },
      "confidence": {
        "type": "string",
        "enum": ["high", "medium", "low", "needs_human_verification"]
      },
      "verification_reason": { "type": "string", "minLength": 1 },
      "method": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": true,
    "allOf": [
      {
        "if": {
          "properties": {
            "confidence": { "const": "needs_human_verification" }
          },
          "required": ["confidence"]
        },
        "then": {
          "required": ["verification_reason"]
        }
      }
    ]
  }
}
